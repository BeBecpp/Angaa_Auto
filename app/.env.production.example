# АНГАА АВТО — production template. Copy to .env on the server and fill the <...> values.
# deploy/install.sh does this for you and generates APP_KEY. Never commit the real .env.

APP_NAME="АНГАА АВТО"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://<your-domain>

APP_LOCALE=mn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BUSINESS_TIMEZONE=Asia/Ulaanbaatar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database -------------------------------------------------------------
# Recommended: MySQL 8.4 (utf8mb4), reachable only on the private network.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=angaa_auto
DB_USERNAME=angaa_app
DB_PASSWORD=<strong-password>
# Small single-server alternative: DB_CONNECTION=sqlite and remove the DB_HOST..DB_PASSWORD lines
# (install.sh then creates database/database.sqlite). Keep it on fast local disk and back it up.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Behind a reverse proxy / load balancer that terminates HTTPS: its IP(s), comma separated, or *.
TRUSTED_PROXIES=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS ------------------------------------------------------------------
# "disabled" until a real provider adapter is implemented and tested (docs/RUNBOOK.md §8).
# With SMS disabled, customer phone sign-in shows "unavailable"; staff features work normally.
SMS_DRIVER=disabled
OTP_LOCAL_VIEWER=false

# Description of the encrypted off-server backup location (no secrets here).
BACKUP_DESTINATION=

VITE_APP_NAME="${APP_NAME}"
